[Unit]
Description=SEER secure network client
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/seer-client/seer_client.py run
Restart=on-failure
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target

